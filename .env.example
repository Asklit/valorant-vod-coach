# Local infrastructure defaults.
APP_VERSION=local
POSTGRES_USER=vodcoach
POSTGRES_PASSWORD=vodcoach
POSTGRES_DB=vodcoach
DATABASE_URL=postgres://vodcoach:vodcoach@localhost:5432/vodcoach?sslmode=disable

CLICKHOUSE_DB=vodcoach
CLICKHOUSE_USER=vodcoach
CLICKHOUSE_PASSWORD=vodcoach
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_SINK_GROUP_ID=vod-clickhouse-sink

REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
KAFKA_SINK_TOPICS=vod.processing.v1,vod.lifecycle.v1

MINIO_ROOT_USER=vodcoach
MINIO_ROOT_PASSWORD=vodcoach-local-password
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=vodcoach-artifacts
S3_ACCESS_KEY_ID=vodcoach
S3_SECRET_ACCESS_KEY=vodcoach-local-password
S3_PREFIX=
# Set automatically by the binaries when S3_ENDPOINT is present; pass
# --s3-path-style=false for AWS S3 virtual-hosted addressing.
S3_USE_PATH_STYLE=true

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=valorant-vod-analysis

# Required only for the first administrator registration. Use a random value.
VODCOACH_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
LOG_FORMAT=json
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
GRAFANA_PUBLIC_URL=http://localhost:3000
PROMETHEUS_PUBLIC_URL=http://localhost:9090
TEMPORAL_UI_PUBLIC_URL=http://localhost:8233
MINIO_PUBLIC_URL=http://localhost:9001
CLICKHOUSE_PUBLIC_URL=http://localhost:8123
ALLOY_PUBLIC_URL=http://localhost:12345

# Optional experimental service boundary; the default guided product requires
# no paid API, local model, or GPU.
VISION_SERVICE_URL=
